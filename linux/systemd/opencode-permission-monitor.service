[Unit]
Description=OpenCode permission monitor
Wants=opencode-server.service
After=opencode-server.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h
Environment="PATH=/usr/local/bin:/usr/bin"
EnvironmentFile=%E/opencode/systemd.env
ExecStart=/bin/bash "%E/opencode/scripts/opencode-permission-monitor.sh" --url http://127.0.0.1:4096 --quiet --log "%S/opencode/permission-monitor.md" --state "%S/opencode/permission-monitor.seen"
Restart=always
RestartSec=10
UMask=0077

[Install]
WantedBy=default.target
