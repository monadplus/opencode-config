{
  "$schema": "https://opencode.ai/tui.json",

  "plugin": [
    "@slkiser/opencode-quota"
  ],

  // https://github.com/dracula/opencode/tree/main
  "theme": "dracula",

  "keybinds": {
    "leader": "ctrl+x",

    "command_list": "ctrl+s",
    "model_list": "ctrl+f",
    "variant_list": "ctrl+t",
    "sidebar_toggle": "ctrl+g",
    "editor_open": "ctrl+p",
    "session_new": "ctrl+n",
    "session_list": "ctrl+l",
    "session_child_first": "ctrl+k",
    "messages_copy": "ctrl+y",
    "messages_undo": "ctrl+u",
    "messages_redo": "ctrl+r",
    "app_exit": "ctrl+d,<leader>+q",

    // Unbind
    "theme_list": "none",
    "model_cycle_recent": "none",
    "model_cycle_recent_reverse": "none",
    "variant_cycle": "none",
    "model_cycle_favorite": "none"
  }
}
