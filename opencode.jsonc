{
  // Validate file: npx prettier --check opencode/opencode.jsonc
  "$schema": "https://opencode.ai/config.json",

  "plugin": [
    "@slkiser/opencode-quota"
  ],

  // Mutating Git and remote actions always require an interactive approval.
  "permission": {
    "edit": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "bash": {
      "*": "ask",
      "git commit*": "ask",
      "git fetch*": "ask",
      "git pull*": "ask",
      "git push*": "ask",
      "gh *": "ask",
      "glab *": "ask"
    }
  },

  // Updates managed through pacman `opencode-bin`
  "autoupdate": false,

  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna",
  "default_agent": "oneshot",

  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "options": {
            "reasoningEffort": "medium"
          },          
          "variants": {
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "gpt-5.6-terra": {
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "gpt-5.6-luna": {
          "options": {
            "reasoningEffort": "xhigh",
            "textVerbosity": "low"
          },
          "variants": {
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    }
  },

  "mcp": {
    // Execute `opencode mcp auth slack` and open the link on the browser 
    // (you may need to auth first with Okta, and try again).
    // It will ask you to approve permissions.
    // "slack": {
    //   "type": "remote",
    //   "url": "https://mcp.slack.com/mcp",
    //   "enabled": true,
    //   "oauth": {
    //     "clientId": "1601185624273.8899143856786",
    //     "redirectUri": "http://localhost:3118/callback"
    //   }
    }
  },

  // Keep the built-in primary agents and narrowly authorize their workers.
  "agent": {
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "color": "warning",
      "permission": {
        "edit": "deny",
        "task": {
          "*": "deny",
          "explore": "allow",
          "review": "allow",
          "rust-design": "allow",
          "scout": "allow",
          "bash-runner": "allow"
        }
      }
    },
    "build": {
      "model": "openai/gpt-5.6-luna",
      "permission": {
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git grep*": "allow",
          "git ls-files*": "allow",
          "git rev-parse*": "allow",
          "git branch": "allow",
          "git branch --show-current": "allow",
          "git remote -v": "allow",
          "pwd": "allow",
          "ls *": "allow"
        },
        "webfetch": "allow",
        "external_directory": {
          "*": "allow"
        },
        "task": {
          "*": "deny",
          "general": "allow",
          "explore": "allow",
          "bash-runner": "allow",
          "review": "allow",
          "scout": "allow",
          "implement": "allow",
          "rust-design": "allow",
          "rust-implement": "allow"
        }
      }
    },
    "oneshot": {
      "mode": "primary",
      "description": "General-purpose agent for tasks and questions without delegation.",
      "model": "openai/gpt-5.6-luna",
      "variant": "max",
      "color": "error",
      "permission": {
        "task": "deny",
        "edit": "ask",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "todowrite": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "lsp": "allow",
        "skill": "allow",
        "external_directory": {
          "*": "allow"
        },
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git grep*": "allow",
          "git ls-files*": "allow",
          "git rev-parse*": "allow",
          "git branch": "allow",
          "git branch --show-current": "allow",
          "git remote -v": "allow",
          "pwd": "allow",
          "ls *": "allow",
          // OpenCode applies the last matching rule, so keep unsafe diff forms last.
          "git diff --output=*": "deny",
          "git diff* --output=*": "deny",
          "git diff --output *": "deny",
          "git diff* --output *": "deny",
          "git diff --ext-diff*": "deny",
          "git diff* --ext-diff*": "deny",
          "git diff --textconv*": "deny",
          "git diff* --textconv*": "deny",
          "git difftool*": "deny"
        }
      }
    },
    "general": {
      "mode": "subagent",
      "description": "Read-only general-purpose subagent for bounded work that does not fit a narrower specialist.",
      "model": "openai/gpt-5.6-luna",
      "permission": {
        "task": "deny",
        "edit": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git grep*": "allow",
          "git ls-files*": "allow",
          "git rev-parse*": "allow",
          "git branch": "allow",
          "git branch --show-current": "allow",
          "git remote -v": "allow",
          "pwd": "allow",
          "ls *": "allow",
          // OpenCode applies the last matching rule, so keep unsafe diff forms last.
          "git diff --output=*": "deny",
          "git diff* --output=*": "deny",
          "git diff --output *": "deny",
          "git diff* --output *": "deny",
          "git diff --ext-diff*": "deny",
          "git diff* --ext-diff*": "deny",
          "git diff --textconv*": "deny",
          "git diff* --textconv*": "deny",
          "git difftool*": "deny"
        }
      }
    },
    "explore": {
      "mode": "subagent",
      "description": "Read-only local code and configuration discovery. Returns concise path and line evidence.",
      "model": "openai/gpt-5.6-luna",
      "permission": {
        "task": "deny",
        "edit": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git grep*": "allow",
          "git ls-files*": "allow",
          "git rev-parse*": "allow",
          "pwd": "allow",
          "ls *": "allow",
          // OpenCode applies the last matching rule, so keep unsafe diff forms last.
          "git diff --output=*": "deny",
          "git diff* --output=*": "deny",
          "git diff --output *": "deny",
          "git diff* --output *": "deny",
          "git diff --ext-diff*": "deny",
          "git diff* --ext-diff*": "deny",
          "git diff --textconv*": "deny",
          "git diff* --textconv*": "deny",
          "git difftool*": "deny"
        }
      }
    }
  }
}
